    <script type="module">
      // Load DOMPurify for HTML sanitization
      // NOTE: Always use DOMPurify instead of native setHTML because native setHTML strips class attributes.
      import DOMPurify from "dompurify";
      Element.prototype.setHTML = function (html) {
