user]/message:w-fit"><div class="flex flex-col gap-4 w-full group-data-[role=user]/message:items-end"><div class=""><div class="flex flex-row gap-2 items-center"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 px-2 h-fit rounded-full text-muted-foreground opacity-100 md:opacity-0 md:group-hover/message:opacity-100" title="Edit message" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M11.75 0.189331L12.2803 0.719661L15.2803 3.71966L15.8107 4.24999L15.2803 4.78032L5.15901 14.9016C4.45575 15.6049 3.50192 16 2.50736 16H0.75H0V15.25V13.4926C0 12.4981 0.395088 11.5442 1.09835 10.841L11.2197 0.719661L11.75 0.189331ZM11.75 2.31065L9.81066 4.24999L11.75 6.18933L13.6893 4.24999L11.75 2.31065ZM2.15901 11.9016L8.75 5.31065L10.6893 7.24999L4.09835 13.841C3.67639 14.2629 3.1041 14.5 2.50736 14.5H1.5V13.4926C1.5 12.8959 1.73705 12.3236 2.15901 11.9016ZM9 16H16V14.5H9V16Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 px-2 h-fit rounded-full text-muted-foreground opacity-100 md:opacity-0 md:group-hover/message:opacity-100" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><div class="flex flex-col gap-4 editorial-user-bubble border border-[var(--c-hair)] bg-[var(--c-panel)] text-[var(--c-text)] px-5 py-3.5 rounded-[20px] rounded-br-[8px]"><p>4 принцип про который ты говоришь важный его нужно зашить</p></div></div></div></div></div></div><div class="w-full mx-auto max-w-3xl px-4 group/message" data-role="assistant" style="opacity: 1; transform: none;"><div class="flex gap-4 w-full group-data-[role=user]/message:ml-auto group-data-[role=user]/message:max-w-2xl group-data-[role=user]/message:w-fit"><div class="flex flex-col gap-4 w-full group-data-[role=user]/message:items-end"><div class=""><div class="flex flex-row gap-2 items-center"><div class="flex flex-col gap-4"><p>Хорошо — 4-й принцип зашиваем как отдельный, обязательный слой системы. Формулирую его явно, потому что это правило, на котором держится вся логика.</p>
<hr>
<h2 class="text-2xl font-semibold mt-6 mb-2">Принцип 4: «Грейд — это кто ты. Оценка A–E — это как ты работал за период»</h2>
<p>Это два <span class="font-semibold">независимых</span> показателя. Их нельзя смешивать, иначе система разваливается.</p>
<div class="overflow-x-auto my-4"><table class="w-full border-collapse text-sm"><thead class="bg-muted/50"><tr class="border-b border-border"><th class="px-3 py-2 text-left font-semibold whitespace-nowrap"></th><th class="px-3 py-2 text-left font-semibold whitespace-nowrap"><span class="font-semibold">Грейд</span></th><th class="px-3 py-2 text-left font-semibold whitespace-nowrap"><span class="font-semibold">Оценка A–E</span></th></tr></thead><tbody><tr class="border-b border-border"><td class="px-3 py-2 align-top"><span class="font-semibold">Что отражает</span></td><td class="px-3 py-2 align-top">Уровень компетенций (потенциал, кто ты)</td><td class="px-3 py-2 align-top">Результат за период (как отработал)</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top"><span class="font-semibold">Из чего считается</span></td><td class="px-3 py-2 align-top">Сумма баллов по всем компетенциям</td><td class="px-3 py-2 align-top">Сумма по компетенциям с флагом «влияет на оценку»</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top"><span class="font-semibold">Как часто меняется</span></td><td class="px-3 py-2 align-top">Медленно — раз в 6–12 месяцев</td><td class="px-3 py-2 align-top">Быстро — за квартал/полгода</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top"><span class="font-semibold">Динамика</span></td><td class="px-3 py-2 align-top">Растёт по мере роста компетенций</td><td class="px-3 py-2 align-top">Может упасть и подняться</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top"><span class="font-semibold">Влияет на</span></td><td class="px-3 py-2 align-top">Оклад, K_грейд в премии</td><td class="px-3 py-2 align-top">Премию за период, план развития</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top"><span class="font-semibold">Может ли упасть</span></td><td class="px-3 py-2 align-top">Редко (пересмотр грейда вниз — исключение)</td><td class="px-3 py-2 align-top"><span class="font-semibold">Да</span>, это нормально</td></tr></tbody></table></div>
<p><span class="font-semibold">Ключевое следствие:</span> один и тот же синьор может получить <span class="font-semibold">C</span> за слабый год. И это не противоречие — это работа системы. Джук с оценкой A ≠ синьор с оценкой A по деньгам: премия = грейд × оценка.</p>
<p><span class="font-semibold">Что это защищает:</span></p>
<ul class="list-decimal list-outside ml-4">
<li class="py-1">грейд не «падает» от плохого квартала → нет демотивации;</li>
<li class="py-1">оценка не «застревает» на уровне компетенций → премия честно отражает результат;</li>
<li class="py-1">сотрудник видит две разные дороги: «расти в уровне» и «работать лучше в этом периоде».</li>
</ul>
<hr>
<h2 class="text-2xl font-semibold mt-6 mb-2">Как это зашивается в расчёт</h2>
<div class="not-prose flex flex-col"><pre class="text-sm w-full overflow-x-auto dark:bg-zinc-900 p-4 border border-zinc-200 dark:border-zinc-700 rounded-xl dark:text-zinc-50 text-zinc-900"><code class="whitespace-pre-wrap wrap-break-word">Блок 1 — ГРЕЙД (пересмотр раз в 6–12 мес)
  Сумма баллов по всем компетенциям → порог → Грейд
  Пример: Мидл 3 LVL = сумма ≥ 45

Блок 2 — ОЦЕНКА A–E (пересмотр за период)
  Сумма по компетенциям с флагом «влияет на оценку» → % → A–E
  Пример: ≥ 90% макс → A

Блок 3 — ПРЕМИЯ (за период)
  Премия = База × K_грейд × K_оценка × K_KPI × K_вклад
  K_оценка: A 1.2 | B 1.0 | C 0.6 | D 0 | E 0
</code></pre></div>
<p><span class="font-semibold">И два поля в карточке сотрудника:</span></p>
<ul class="list-decimal list-outside ml-4">
<li class="py-1"><code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Грейд</code> (текущий, с датой пересмотра)</li>
<li class="py-1"><code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Оценка за период</code> (текущая, с датой периода)</li>
</ul>
<hr>
<h2 class="text-2xl font-semibold mt-6 mb-2">Один нюанс, который надо решить сейчас</h2>
<p>Чтобы принцип работал, нужен <span class="font-semibold">лаговый механизм</span> — иначе система начнёт путаться:</p>
<p><span class="font-semibold">Вопрос: премия считается по грейду на конец периода или на начало?</span></p>
<ul class="list-decimal list-outside ml-4">
<li class="py-1"><span class="font-semibold">На начало периода</span> — честнее: сотрудник работал в этом грейде, за него и премия. Повышение в грейде не удваивает выплату.</li>
<li class="py-1"><span class="font-semibold">На конец</span> — стимулирует быстрый рост, но создаёт «гонку за повышением перед премией».</li>
</ul>
<p>Обычно берут <span class="font-semibold">на начало периода</span> (или среднее за период). Если скажешь — зашью правило.</p>
<hr>
<h2 class="text-2xl font-semibold mt-6 mb-2">Что мне осталось для сборки файла</h2>
<p>Три цифры — и я собираю финальный конструктор:</p>
<ol class="list-decimal list-outside ml-4">
<li class="py-1"><span class="font-semibold">Пороги грейдов</span> (сколько баллов = какой грейд) — свои или взять мои: Джун 1 ≥20, Мидл 3 ≥45, Синьор 5 ≥70?</li>
<li class="py-1"><span class="font-semibold">База премии</span> — % от оклада (20% / 30% / фикс)?</li>
<li class="py-1"><span class="font-semibold">Период</span> — квартал / полгода / год?</li>
</ol>
<p>Плюс уточни <span class="font-semibold">лаговый механизм</span> (грейд на начало или конец периода).</p>
<p>Ответишь — соберу файл с шестью листами: <span class="font-semibold">Компетенции → Оценки → Грейд → A–E → Премии → Дашборд + Риски (bus factor)</span>, где принцип 4 зашит явно и подписан на каждом листе.</p>
<p>Если пороги и базу проще показать в твоём Excel — продублируй их текстом (я не могу прочитать содержимое <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">attachment-1</code> напрямую), и я вставлю один в один.</p></div></div></div><div class="mt-3 flex flex-row items-center gap-1"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" title="Копировать"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var