5 4.53032L5.81068 3.99999L4.75002 2.93933L4.21969 3.46966L0.39647 7.29289C0.00594562 7.68341 0.00594562 8.31658 0.39647 8.7071L4.21969 12.5303ZM11.7804 12.5303L11.25 13.0607L10.1894 12L10.7197 11.4697L14.1894 7.99999L10.7197 4.53032L10.1894 3.99999L11.25 2.93933L11.7804 3.46966L15.6036 7.29289C15.9941 7.68341 15.9941 8.31658 15.6036 8.7071L11.7804 12.5303Z" fill="currentColor"></path></svg></span></div><div class="flex flex-col gap-0.5 min-w-0"><span class="font-medium text-sm truncate">generate_qa_system.py</span><span class="text-xs text-muted-foreground">PY · <!-- -->Нажмите для открытия</span></div></button><div class="flex items-center gap-1 shrink-0"><button type="button" title="Скачать файл" class="p-1.5 rounded-md hover:bg-muted text-muted-foreground hover:text-foreground transition-colors disabled:opacity-40 disabled:cursor-not-allowed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.75 1V1.75V8.68934L10.7197 6.71967L11.25 6.18934L12.3107 7.25L11.7803 7.78033L8.70711 10.8536C8.31658 11.2441 7.68342 11.2441 7.29289 10.8536L4.21967 7.78033L3.68934 7.25L4.75 6.18934L5.28033 6.71967L7.25 8.68934V1.75V1H8.75ZM13.5 9.25V13.5H2.5V9.25V8.5H1V9.25V14C1 14.5523 1.44771 15 2 15H14C14.5523 15 15 14.5523 15 14V9.25V8.5H13.5V9.25Z" fill="currentColor"></path></svg></button><button type="button" title="Открыть файл" class="p-1.5 rounded-md hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M1 5.25V6H2.5V5.25V2.5H5.25H6V1H5.25H2C1.44772 1 1 1.44772 1 2V5.25ZM5.25 14.9994H6V13.4994H5.25H2.5V10.7494V9.99939H1V10.7494V13.9994C1 14.5517 1.44772 14.9994 2 14.9994H5.25ZM15 10V10.75V14C15 14.5523 14.5523 15 14 15H10.75H10V13.5H10.75H13.5V10.75V10H15ZM10.75 1H10V2.5H10.75H13.5V5.25V6H15V5.25V2C15 1.44772 14.5523 1 14 1H10.75Z" fill="currentColor"></path></svg></button></div></div></div><div class=""><div class="flex flex-row gap-2 items-center"><div class="flex flex-col gap-4"><p>Готово — исправленный скрипт <span class="font-semibold"><code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">generate_qa_system.py</code></span> выложен одним файлом (скачивай).</p>
<h2 class="text-2xl font-semibold mt-6 mb-2">Что исправлено</h2>
<div class="overflow-x-auto my-4"><table class="w-full border-collapse text-sm"><thead class="bg-muted/50"><tr class="border-b border-border"><th class="px-3 py-2 text-left font-semibold whitespace-nowrap">Было</th><th class="px-3 py-2 text-left font-semibold whitespace-nowrap">Стало</th></tr></thead><tbody><tr class="border-b border-border"><td class="px-3 py-2 align-top">3 отдельных файла</td><td class="px-3 py-2 align-top"><span class="font-semibold">1 файл</span>, создаёт всё сразу</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top">Формулы с <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Оценки!B2</code> (без кавычек) → Excel не считал</td><td class="px-3 py-2 align-top"><code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">'Оценки'!B2</code> — <span class="font-semibold">в апострофах</span> ✔</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top">Блок «Нормы грейда» налезал на примечание</td><td class="px-3 py-2 align-top">нормальный отступ, ничего не съезжает</td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top"><code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">% грейд</code>, <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Сумма</code> пустые</td><td class="px-3 py-2 align-top"><span class="font-semibold">живые формулы SUMPRODUCT</span></td></tr><tr class="border-b border-border"><td class="px-3 py-2 align-top">Премия считалась от заглушки</td><td class="px-3 py-2 align-top">база вписана (90/85/80/70 тыс.)</td></tr></tbody></table></div>
<h2 class="text-2xl font-semibold mt-6 mb-2">Запуск</h2>
<div class="not-prose flex flex-col"><pre class="text-sm w-full overflow-x-auto dark:bg-zinc-900 p-4 border border-zinc-200 dark:border-zinc-700 rounded-xl dark:text-zinc-50 text-zinc-900"><code class="whitespace-pre-wrap wrap-break-word">cd ~/Documents
python3 generate_qa_system.py
open QA_System.xlsx
</code></pre></div>
<p>Файл создастся <span class="font-semibold">целиком</span> — 5 листов, лист «Итог» с <span class="font-semibold">рабочими формулами</span>.</p>
<hr>
<h2 class="text-2xl font-semibold mt-6 mb-2">⚠️ Один момент про Excel</h2>
<p>Если при открытии Excel покажет колонку <span class="font-semibold">«% грейд»</span> с ошибкой <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">#NAME?</code> или <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">0</code> — это из-за <span class="font-semibold">кириллицы в именах листов</span> внутри SUMPRODUCT (редкий баг Excel/OpenOffice).</p>
<p><span class="font-semibold">Тогда сделаем так:</span> переименуем листы в латиницу (<code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Comp</code>, <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Scores</code>, <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Tasks</code>) — формулы станут 100% совместимыми, а названия вкладок можно оставить красивыми в первой колонке.</p>
<p><span class="font-semibold">Проверь после запуска:</span> что показывает колонка <span class="font-semibold">«% грейд»</span> — числа (86/80/79/60) или ошибку? Напиши — и если ошибка, пришлю латинскую версию.</p></div></div></div><div class="mt-3 flex flex-row items-center gap-1"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" title="Копировать"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:siz