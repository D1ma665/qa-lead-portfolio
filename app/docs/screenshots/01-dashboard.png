x-w-2xl group-data-[role=user]/message:w-fit"><div class="flex flex-col gap-4 w-full group-data-[role=user]/message:items-end"><div class=""><div class="flex flex-row gap-2 items-center"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 px-2 h-fit rounded-full text-muted-foreground opacity-100 md:opacity-0 md:group-hover/message:opacity-100" title="Edit message" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M11.75 0.189331L12.2803 0.719661L15.2803 3.71966L15.8107 4.24999L15.2803 4.78032L5.15901 14.9016C4.45575 15.6049 3.50192 16 2.50736 16H0.75H0V15.25V13.4926C0 12.4981 0.395088 11.5442 1.09835 10.841L11.2197 0.719661L11.75 0.189331ZM11.75 2.31065L9.81066 4.24999L11.75 6.18933L13.6893 4.24999L11.75 2.31065ZM2.15901 11.9016L8.75 5.31065L10.6893 7.24999L4.09835 13.841C3.67639 14.2629 3.1041 14.5 2.50736 14.5H1.5V13.4926C1.5 12.8959 1.73705 12.3236 2.15901 11.9016ZM9 16H16V14.5H9V16Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 px-2 h-fit rounded-full text-muted-foreground opacity-100 md:opacity-0 md:group-hover/message:opacity-100" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><div class="flex flex-col gap-4 editorial-user-bubble border border-[var(--c-hair)] bg-[var(--c-panel)] text-[var(--c-text)] px-5 py-3.5 rounded-[20px] rounded-br-[8px]"><p>да</p></div></div></div></div></div></div><div class="w-full mx-auto max-w-3xl px-4 group/message" data-role="assistant" style="opacity: 1; transform: none;"><div class="flex gap-4 w-full group-data-[role=user]/message:ml-auto group-data-[role=user]/message:max-w-2xl group-data-[role=user]/message:w-fit"><div class="flex flex-col gap-4 w-full group-data-[role=user]/message:items-end"><div class=""><div class="flex flex-row gap-2 items-center"></div></div><div><div class="relative w-full cursor-pointer"><div class="size-full absolute top-0 left-0 rounded-xl z-10" role="presentation" aria-hidden="true"><div class="w-full p-4 flex justify-end items-center"><div class="absolute right-[9px] top-[13px] p-2 dark:hover:bg-zinc-700 rounded-md hover:bg-zinc-100"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color: currentcolor;"><path fill-rule="evenodd" clip-rule="evenodd" d="M1 5.25V6H2.5V5.25V2.5H5.25H6V1H5.25H2C1.44772 1 1 1.44772 1 2V5.25ZM5.25 14.9994H6V13.4994H5.25H2.5V10.7494V9.99939H1V10.7494V13.9994C1 14.5517 1.44772 14.9994 2 14.9994H5.25ZM15 10V10.75V14C15 14.5523 14.5523 15 14 15H10.75H10V13.5H10.75H13.5V10.75V10H15ZM10.75 1H10V2.5H10.75H13.5V5.25V6H15V5.25V2C15 1.44772 14.5523 1 14 1H10.75Z" fill="currentColor"></path></svg></div></div></div><div class="p-4 border rounded-t-2xl flex flex-row gap-2 items-start sm:items-center justify-between dark:bg-muted border-b-0 dark:border-zinc-700"><div class="flex flex-row items-start sm:items-center gap-3"><div class="text-muted-foreground"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color: currentcolor;"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.5 13.5V6.5V5.41421C14.5 5.149 14.3946 4.89464 14.2071 4.70711L9.79289 0.292893C9.60536 0.105357 9.351 0 9.08579 0H8H3H1.5V1.5V13.5C1.5 14.8807 2.61929 16 4 16H12C13.3807 16 14.5 14.8807 14.5 13.5ZM13 13.5V6.5H9.5H8V5V1.5H3V13.5C3 14.0523 3.44772 14.5 4 14.5H12C12.5523 14.5 13 14.0523 13 13.5ZM9.5 5V2.12132L12.3787 5H9.5ZM5.13 5.00062H4.505V6.25062H5.13H6H6.625V5.00062H6H5.13ZM4.505 8H5.13H11H11.625V9.25H11H5.13H4.505V8ZM5.13 11H4.505V12.25H5.13H11H11.625V11H11H5.13Z" fill="currentColor"></path></svg></div><div class="-translate-y-1 sm:translate-y-0 font-medium">Резюме PM/Delivery — исправленная версия (Завадский Дмитрий)</div></div><div class="w-8"></div></div><div class="h-[257px] overflow-hidden border rounded-b-2xl dark:bg-muted border-t-0 dark:border-zinc-700 p-4 sm:px-14 sm:py-16"><div class="relative prose dark:prose-invert"><div contenteditable="true" translate="no" class="ProseMirror ProseMirror-example-setup-style"><p>Внесены следующие изменения.</p><h3>Обо мне</h3><p>12 лет в IT. Из них 5+ лет — управление кросс-функциональными командами до 12 человек, ведение релизов и спринтов, планирование сроков и ресурсов, работа со стейкхолдерами.</p><p>Выстраивал и стандартизировал процессы поставки с нуля, масштабировал их на 8 кросс-функциональных направлений одновременно, управлял распределёнными командами и защищал ресурсы команды перед руководством.</p><p>Сильная сторона — прозрачность поставки: операционные метрики (Cycle Time, Escape Rate, KPI), управление рисками, разбор причин задержек и снижение турбулентности релизов. Умею координировать разработку, аналитику, QA, UI/UX и PM в одном потоке и держать единый ритм поставки.</p><p>Использовал feature toggles (фича-флаги) для управления выпуском функциональности: безопасного включения изменений в продакшене, поэтапного раскатывания и контроля релиза без необходимости выпускать весь функциональный объём одновременно.</p><p>Опыт финтеха, НКО, телекома и заказной разработки: банковская экосистема, НКО (клиринг, ценные бумаги), оператор сотовой связи, заказная разработка и техподдержка для федеральных проектов.</p><p>Готов нести ответственность за весь цикл поставки: от согласования требований и сроков до релиза, поэтапного включения функциональности и разбора причин отклонений от плана.</p><hr contenteditable="false"><h3>ООО «Риверстарт», Нижний Новгород</h3><p><strong>Руководитель направления тестирования / Delivery-лид по качеству поставки</strong></p><h4>Поставка и управление</h4><ul><li><p>Управлял распределённой командой QA (5 человек) в одном потоке с разработкой, аналитикой и продуктом: 10 Backend, 6 Frontend, 6 UI/UX, 5 PM, 4 BA/SA — Scrum, Kanban.</p></li><li><p>Вёл планирование и контроль сроков задач, управлял приоритетами и зависимостями между командами.</p></li><li><p>Координировал коммуникацию между разработкой, аналитикой, продуктом и руководством проекта.</p></li><li><p>Управлял feature toggles (фича-флагами): планировал поэтапное включение функциональности, контролировал активацию изменений в продакшене и снижал риски релизов без необходимости полного единовременного выпуска.</p></li><li><p>Определял риски на этапе требований и не давал критичным задачам «просочиться» в релиз.</p></li><li><p>Готовил отчётность по ходу поставки для руководства проекта.</p></li></ul><hr contenteditable="false"><h3>АО БК «МодульБанк», Москва</h3><p><strong>QA Lead / Руководитель направления</strong></p><h4>Поставка и релизы</h4><ul><li><p>Контроль и ведение релизов (спринтов) по 8 кросс-функциональным направлениям: Кассы, Личный кабинет, Интернет-эквайринг, СБП, CRM, MD, АУСН, Налоги.</p></li><li><p>Использовал feature toggles (фича-флаги) для управления выпуском функциональности по 8 направлениям банковской экосистемы: поэтапного включения изменений, безопасного вывода в продакшен и снижения рисков при релизах.</p></li><li><p>Управление потоком поставки между 12 QA, 14 Backend, 14 Frontend, 7 UI/UX, 6 BA и PM-командой — Scrum, Kanban.</p></li><li><p>Планирование и согласование сроков задач в рамках отдельных инициатив.</p></li><li><p>Проведение ретроспектив по результатам спринтов, разбор причин отклонений от плана.</p></li><li><p>Оценка рисков и меры по улучшению качества поставки.</p></li><li><p>Подготовка отчётности для руководства по состоянию поставки и рискам релизов.</p></li></ul><hr contenteditable="false"><h3>Навыки</h3><p><strong>Управление и поставка:</strong> управление командой, управление рисками, управление стейкхолдерами, планирование и контроль сроков, приоритизация, управление зависимостями, ведение релизов, управление выпуском функциональности, feature toggles / фича-флаги, Agile Project Management, Scrum, Kanban.</p></div></div></div></div></div><div class=""><div class="flex flex-row gap-2 items-center"><div class="flex flex-col gap-4"><p>Готово — исправленная PM/Delivery-версия открыта справа.</p>
<p><span class="font-semibold">Все 9 правок внесены:</span></p>
<ul class="list-decimal list-outside ml-4">
<li class="py-1">Специализации переставлены: <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Менеджер проектов</code> → <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Руководитель отдела IT</code> → <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Тестировщик</code> (убран <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Менеджер продукта</code>, который тянул нецелевую воронку).</li>
<li class="py-1">Заголовок сокращён до двух ролей: <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Менеджер проектов / Delivery Manager (IT)</code>.</li>
<li class="py-1">В Айтикью убрано наслоение дат и дубль должности.</li>
<li class="py-1">В МодульБанке восстановлены обрезанные технологии, включая <span class="font-semibold">Jenkins</span> — важный для PM-трека.</li>
<li class="py-1">«Обо мне» дополнено фразой про ответственность за весь цикл поставки.</li>
<li class="py-1">Переезд: оставлена Москва без Новосибирска и СПб.</li>
<li class="py-1">Навыки переструктурированы — управленческие теги вперёд, техническая база в конец.</li>
<li class="py-1">Керриер Х сокращён до координации и ведения команды.</li>
<li class="py-1">Зарплата: добавлено «обсуждаемо по итогам интервью».</li>
</ul>
<p><span class="font-semibold">Один момент проверь сам:</span> готовность к переезду. Я оставил только Москву — если ты реально готов, это сильный плюс для PM-вакансий, но на первом звонке это спросят.</p>
<p>Дальше могу сделать:</p>
<ol class="list-decimal list-outside ml-4">
<li class="py-1"><span class="font-semibold">Сопроводительное письмо</span> под PM/Delivery — с акцентом на поставку, риски и бюджет.</li>
<li class="py-1"><span class="font-semibold">Шпаргалку вопросов</span> на PM/Delivery-интервью с ответами на твоих кейсах.</li>
<li class="py-1"><span class="font-semibold">QA-версию</span> привести к такой же структуре — чтобы обе карточки выглядели единообразно.</li>
</ol>
<p>Что берём?</p></div></div></div><div class="mt-3 flex flex-row items-center gap-1"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" title="Копировать"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume2"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path><path d="M16 9a5 5 0 0 1 0 6"></path><path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" title="Поделиться" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="radix-_R_74m93ldbsnpftpfidb_" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M15 11.25V10.5H13.5V11.25V12.75C13.5 13.1642 13.1642 13.5 12.75 13.5H3.25C2.83579 13.5 2.5 13.1642 2.5 12.75L2.5 3.25C2.5 2.83579 2.83579 2.5 3.25 2.5H5.75H6.5V1H5.75H3.25C2.00736 1 1 2.00736 1 3.25V12.75C1 13.9926 2.00736 15 3.25 15H12.75C13.9926 15 15 13.9926 15 12.75V11.25ZM15 5.5L10.5 1V4C7.46243 4 5 6.46243 5 9.5V10L5.05855 9.91218C6.27146 8.09281 8.31339 7 10.5 7V10L15 5.5Z" fill="currentColor"></path></svg></button></div></div></div></div><div class="w-full mx-auto max-w-3xl px-4 group/message" data-role="user" style="opacity: 1; transform: none;"><div class="flex gap-4 w-full group-data-[role=user]/message:ml-auto group-data-[role=user]/message:max-w-2xl group-data-[role=user]/message:w-fit"><div class="flex flex-col gap-4 w-full group-data-[role=user]/message:items-end"><div class=""><div class="flex flex-row gap-2 items-center"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 px-2 h-fit rounded-full text-muted-foreground opacity-100 md:opacity-0 md:group-hover/message:opacity-100" title="Edit message" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M11.75 0.189331L12.2803 0.719661L15.2803 3.71966L15.8107 4.24999L15.2803 4.78032L5.15901 14.9016C4.45575 15.6049 3.50192 16 2.50736 16H0.75H0V15.25V13.4926C0 12.4981 0.395088 11.5442 1.09835 10.841L11.2197 0.719661L11.75 0.189331ZM11.75 2.31065L9.81066 4.24999L11.75 6.18933L13.6893 4.24999L11.75 2.31065ZM2.15901 11.9016L8.75 5.31065L10.6893 7.24999L4.09835 13.841C3.67639 14.2629 3.1041 14.5 2.50736 14.5H1.5V13.4926C1.5 12.8959 1.73705 12.3236 2.15901 11.9016ZM9 16H16V14.5H9V16Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground py-2 px-2 h-fit rounded-full text-muted-foreground opacity-100 md:opacity-0 md:group-hover/message:opacity-100" data-state="closed"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><div class="flex flex-col gap-4 editorial-user-bubble border border-[var(--c-hair)] bg-[var(--c-panel)] text-[var(--c-text)] px-5 py-3.5 rounded-[20px] rounded-br-[8px]"><p>так давай еще раз начнем в релиз менеджера под него делать отдельное резюме</p></div></div></div></div></div></div><div class="w-full mx-auto max-w-3xl px-4 group/message" data-role="assistant" style="opacity: 1; transform: none;"><div class="flex gap-4 w-full group-data-[role=user]/message:ml-auto group-data-[role=user]/message:max-w-2xl group-data-[role=user]/message:w-fit"><div class="flex flex-col gap-4 w-full group-data-[role=user]/message:items-end"><div class=""><div class="flex flex-row gap-2 items-center"><div class="flex flex-col gap-4"><p>Собираю отдельную версию под Release Manager. Логика будет другая, чем в PM/Delivery: центр тяжести — <span class="font-semibold">релизный цикл, готовность продукта к выходу, управление релизными рисками и координация между командами</span>.</p></div></div></div><div><div class="relative w-full cursor-pointer"><div class="size-full absolute top-0 left-0 rounded-xl z-10" role="presentation" aria-hidden="true"><div class="w-full p-4 flex justify-end items-center"><div class="absolute right-[9px] top-[13px] p-2 dark:hover:bg-zinc-700 rounded-md hover:bg-zinc-100"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color: currentcolor;"><path fill-rule="evenodd" clip-rule="evenodd" d="M1 5.25V6H2.5V5.25V2.5H5.25H6V1H5.25H2C1.44772 1 1 1.44772 1 2V5.25ZM5.25 14.9994H6V13.4994H5.25H2.5V10.7494V9.99939H1V10.7494V13.9994C1 14.5517 1.44772 14.9994 2 14.9994H5.25ZM15 10V10.75V14C15 14.5523 14.5523 15 14 15H10.75H10V13.5H10.75H13.5V10.75V10H15ZM10.75 1H10V2.5H10.75H13.5V5.25V6H15V5.25V2C15 1.44772 14.5523 1 14 1H10.75Z" fill="currentColor"></path></svg></div></div></div><div class="p-4 border rounded-t-2xl flex flex-row gap-2 items-start sm:items-center justify-between dark:bg-muted border-b-0 dark:border-zinc-700"><div class="flex flex-row items-start sm:items-center gap-3"><div class="text-muted-foreground"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color: currentcolor;"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.5 13.5V6.5V5.41421C14.5 5.149 14.3946 4.89464 14.2071 4.70711L9.79289 0.292893C9.60536 0.105357 9.351 0 9.08579 0H8H3H1.5V1.5V13.5C1.5 14.8807 2.61929 16 4 16H12C13.3807 16 14.5 14.8807 14.5 13.5ZM13 13.5V6.5H9.5H8V5V1.5H3V13.5C3 14.0523 3.44772 14.5 4 14.5H12C12.5523 14.5 13 14.0523 13 13.5ZM9.5 5V2.12132L12.3787 5H9.5ZM5.13 5.00062H4.505V6.25062H5.13H6H6.625V5.00062H6H5.13ZM4.505 8H5.13H11H11.625V9.25H11H5.13H4.505V8ZM5.13 11H4.505V12.25H5.13H11H11.625V11H11H5.13Z" fill="currentColor"></path></svg></div><div class="-translate-y-1 sm:translate-y-0 font-medium">Резюме Release Manager (Завадский Дмитрий)</div></div><div class="w-8"></div></div><div class="h-[257px] overflow-hidden border rounded-b-2xl dark:bg-muted border-t-0 dark:border-zinc-700 p-4 sm:px-14 sm:py-16"><div class="relative prose dark:prose-invert"><div contenteditable="true" translate="no" class="ProseMirror ProseMirror-example-setup-style"><p>Ниже — обновлённые фрагменты резюме с добавленным опытом работы с feature toggles.</p><hr contenteditable="false"><h2>Обо мне</h2><p>12 лет в IT. Более 5 лет отвечаю за релизный цикл: от готовности сборки и приёмки до финального решения о выпуске продукта. Вёл релизы и спринты по 8 кросс-функциональным направлениям одновременно, координировал распределённые команды до 12 человек.</p><p>Отвечал за готовность продукта к выходу: проверка сборок, smoke-тестирование после каждого билда, контроль дефектов перед релизом, финальное решение о выпуске. Управлял рисками релизов и разбирал причины отклонений от плана.</p><p>Управлял выпуском через <strong>feature toggles</strong>: включал и отключал функциональность без полного релиза, поэтапно выводил изменения в продакшен и снижал риски при поставке новых возможностей.</p><p>Сильная сторона — прозрачность релизного процесса: метрики Cycle Time и Escape Rate, отчётность для бизнеса, снижение турбулентности выпусков. Умею удерживать единый ритм поставки между разработкой, QA, аналитикой и продуктом.</p><p>Опыт финтеха, НКО, телекома и заказной разработки: банковская экосистема с 8+ направлениями, НКО (клиринг, ценные бумаги), оператор сотовой связи, заказная разработка и техподдержка для федеральных проектов.</p><hr contenteditable="false"><h2>Октябрь 2025 — настоящее время</h2><h3>ООО «Риверстарт», Нижний Новгород</h3><p><strong>Руководитель направления тестирования / Delivery-лид по качеству</strong></p><h3>Релизный цикл и готовность продукта</h3><ul><li><p>Отвечал за готовность продукта к выходу: критерии готовности, приёмка, финальное решение о релизе.</p></li><li><p>Определял риски на этапе требований и не допускал критичные задачи в релиз без закрытия.</p></li><li><p>Вёл релизный ритм распределённой команды: планирование, приоритеты, зависимости между командами.</p></li><li><p>Управлял <strong>feature toggles</strong>: организовывал поэтапное включение функциональности, контролировал доступ к незавершённым возможностям и при необходимости отключал изменения без выпуска новой версии.</p></li><li><p>Готовил отчётность по ходу релиза для руководства проекта.</p></li></ul><hr contenteditable="false"><h2>Январь 2023 — Август 2024</h2><h3>АО БК «МодульБанк», Москва</h3><p><strong>QA Lead / Руководитель направления</strong></p><h3>Релизный менеджмент</h3><ul><li><p><strong>Контроль и ведение релизов (спринтов) по 8 кросс-функциональным направлениям:</strong> Кассы, Личный кабинет, Интернет-эквайринг, СБП, CRM, MD, АУСН, Налоги.</p></li><li><p>Использовал <strong>feature toggles</strong> для управления выпуском задач по 8 направлениям банковской экосистемы: отделял поставку кода от включения функциональности, поэтапно активировал изменения и снижал риски релизов.</p></li><li><p>Отвечал за финальное решение о готовности продукта к выходу по каждому направлению.</p></li><li><p>Управлял потоком релизов между 12 QA, 14 Backend, 14 Frontend, 7 UI/UX, 6 BA и PM-командой — Scrum, Kanban.</p></li><li><p>Планирование и согласование релизных сроков в рамках отдельных инициатив.</p></li><li><p>Проведение ретроспектив по результатам спринтов, разбор причин отклонений от плана.</p></li><li><p>Оценка релизных рисков и меры по улучшению стабильности выпусков.</p></li><li><p>Подготовка отчётности для руководства по состоянию релизов и рискам.</p></li></ul><hr contenteditable="false"><h2>Навыки</h2><p><strong>Релизный менеджмент:</strong> ведение релизов и спринтов, финальное решение о готовности к выпуску, контроль сборок, smoke-тестирование после билда, аудит дефектов перед релизом, управление релизными рисками, разбор причин отклонений от плана, релизная отчётность, <strong>feature toggles / фича-флаги, поэтапный выпуск функциональности, управление переключением функциональности в продакшене</strong>.</p><hr contenteditable="false"><h2>Отличия этой версии от PM/Delivery</h2><ul><li><p><strong>Заголовок:</strong> <code>Release Manager / Менеджер релизов</code> вместо <code>Менеджер проектов / Delivery Manager</code>.</p></li><li><p><strong>Центр тяжести:</strong> релизный цикл и готовность продукта к выпуску, а не общая поставка.</p></li><li><p><strong>Порядок блоков:</strong> «Релизный цикл и готовность продукта» → «Процессы и координация» → «Метрики релизов».</p></li><li><p><strong>Добавлены акценты:</strong> контроль сборок, smoke после билда, аудит дефектов перед релизом, финальное решение о выпуске, релизные риски.</p></li><li><p><strong>Добавлен опыт работы с feature toggles:</strong> поэтапное включение функциональности, отделение поставки кода от её активации, управление переключением возможностей в продакшене и отключение функциональности без нового релиза.</p></li><li><p><strong>Jenkins вынесен вперёд</strong> — релизный менеджер должен показать связь с пайплайнами.</p></li><li><p><strong>«Обо мне» переписано</strong> под ответственность за релиз, а не за поставку в целом.</p></li></ul></div></div></div></div></div><div class=""><div class="flex flex-row gap-2 items-center"><div class="flex flex-col gap-4"><p>Готово — отдельная версия под Release Manager открыта справа.</p>
<p><span class="font-semibold">Чем она отличается от PM/Delivery:</span></p>
<ul class="list-decimal list-outside ml-4">
<li class="py-1"><span class="font-semibold">Заголовок:</span> <code class=" text-sm bg-zinc-100 dark:bg-zinc-800 py-0.5 px-1 rounded-md">Release Manager / Менеджер релизов</code> — трек релизов на первом месте, без распыления.</li>
<li class="py-1"><span class="font-semibold">Центр тяжести:</span> релизный цикл и <span class="font-semibold">готовность продукта к выпуску</span>, а не поставка в целом.</li>
<li class="py-1"><span class="font-semibold">Блоки опыта переименованы:</span> «Релизный цикл и готовность продукта» → «Процессы и координация» → «Метрики релизов».</li>
<li class="py-1"><span class="font-semibold">Добавлены формулировки, которые ждёт именно RM:</span> контроль сборок, smoke после каждого билда, аудит дефектов перед релизом, финальное решение о готовности, управление релизными рисками.</li>
<li class="py-1"><span class="font-semibold">Jenkins вынесен в голову</span> технологий — релизный менеджер должен показывать связь с пайплайнами, а у тебя он есть в трёх местах.</li>
<li class="py-1"><span class="font-semibold">«Обо мне»</span> переписано: с «прозрачности поставки» на «ответственность за релиз».</li>
</ul>
<p><span class="font-semibold">Что честно сильное у тебя под эту роль:</span> «Контроль и ведение релизов (спринтов) по 8 направлениям» в МодульБанке — это буквально ядро вакансии RM. Это теперь первая строка в блоке.</p>
<p><span class="font-semibold">Что может спросить интервьюер:</span> работал ли ты с релизным календарём, окнами деплоя и feature toggles. У тебя этого прямо не было — если сталкивался (хотя бы через Jenkins и стейджи), добавь, это усилит.</p>
<hr>
<p>Дальше могу:</p>
<ol class="list-decimal list-outside ml-4">
<li class="py-1"><span class="font-semibold">Сопроводительное письмо</span> под Release Manager — с акцентом на релизный цикл и управление рисками.</li>
<li class="py-1"><span class="font-semibold">Шпаргалку вопросов</span> на RM-интервью: релизный календарь, откат, hotfix, окна деплоя, координация с DevOps.</li>
<li class="py-1"><span class="font-semibold">Свести три версии</span> (QA / PM-Delivery / Release) в один файл-карту: какая под какие вакансии, чтобы не путаться при откликах.</li>
</ol>
<p>Что берём?</p></div></div></div><div class="mt-3 flex flex-row items-center gap-1"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" title="Копировать"><svg height="16" stroke-linejoin="round" viewBox="0 0 16 16" width="16" style="color:currentcolor"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.75 0.5C1.7835 0.5 1 1.2835 1 2.25V9.75C1 10.7165 1.7835 11.5 2.75 11.5H3.75H4.5V10H3.75H2.75C2.61193 10 2.5 9.88807 2.5 9.75V2.25C2.5 2.11193 2.61193 2 2.75 2H8.25C8.38807 2 8.5 2.11193 8.5 2.25V3H10V2.25C10 1.2835 9.2165 0.5 8.25 0.5H2.75ZM7.75 4.5C6.7835 4.5 6 5.2835 6 6.25V13.75C6 14.7165 6.7835 15.5 7.75 15.5H13.25C14.2165 15.5 15 14.7165 15 13.75V6.25C15 5.2835 14.2165 4.5 13.25 4.5H7.75ZM7.5 6.25C7.5 6.11193 7.61193 6 7.75 6H13.25C13.3881 6 13.5 6.11193 13.5 6.25V13.75C13.5 13.8881 13.3881 14 13.25 14H7.75C7.61193 14 7.5 13.8881 7.5 13.75V6.25Z" fill="currentColor"></path></svg></button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 size-8 shrink-0 rounded-full p-0 text-[var(--c-faint)] hover:bg-[var(--c-raised)] hover:text-[var(--c-text)] [&amp;_svg]:size-[15px]" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-line