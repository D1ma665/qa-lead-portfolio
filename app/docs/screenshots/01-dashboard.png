tusFailed\":\"Не удалось сгенерировать\",\"download\":\"Скачать\",\"delete\":\"Удалить\",\"heroTitle\":\"Видео\",\"heroSubtitle\":\"Опишите видео, которое хотите создать\",\"presetsTitle\":\"Идеи для видео\",\"myVideosTitle\":\"Мои видео\",\"attachImage\":\"Добавить изображение\",\"voiceInput\":\"Голосовой ввод\",\"generate\":\"Создать\",\"presets\":{\"cinematic\":{\"label\":\"Кинематографичный кадр\",\"prompt\":\"Кинематографичный кадр: одинокий путник идёт по неоновому городу под дождём, медленное движение камеры, мягкий боке-свет, киноатмосфера\"},\"nature\":{\"label\":\"Дикая природа\",\"prompt\":\"Орёл парит над туманными горами на рассвете, плавный облёт камерой, золотой час, фотореалистично\"},\"product\":{\"label\":\"Реклама продукта\",\"prompt\":\"Эффектный рекламный ролик флакона духов на подиуме, вращение камеры, студийный свет, капли воды, премиальная подача\"},\"anime\":{\"label\":\"Аниме-сцена\",\"prompt\":\"Аниме-сцена: девушка с развевающимися волосами стоит на крыше под закатным небом, лёгкий ветер, насыщенные цвета в стиле японской анимации\"},\"cyberpunk\":{\"label\":\"Киберпанк\",\"prompt\":\"Киберпанк-улица будущего ночью, голограммы и неон, пролёт камеры сквозь толпу, дождь, отражения, атмосфера blade runner\"},\"portrait\":{\"label\":\"Портрет крупным планом\",\"prompt\":\"Крупный портрет человека у окна, мягкий естественный свет, лёгкое движение, кинематографичная глубина резкости\"}},\"models\":{\"veo31\":{\"speed\":\"~3 мин\",\"description\":\"Флагман Google. Картинка кинокачества в 720p, синхронный звук и точное следование вашему описанию — вплоть до движения камеры и реплик героев.\"},\"veo31fast\":{\"speed\":\"~90 с\",\"description\":\"Ускоренная Veo 3.1: те же кадры и встроенный звук, но в несколько раз быстрее. Отличный выбор для черновиков и быстрых проб идей.\"},\"kling3pro\":{\"speed\":\"~3 мин\",\"description\":\"Kling 3 Pro для зрелищных роликов: продвинутая физика движения, выразительный свет и плавные, естественные планы.\"},\"seedancePro\":{\"speed\":\"~2 мин\",\"description\":\"Seedance Pro от ByteDance. Реалистичная динамика, устойчивое движение без артефактов и чистая, стабильная анимация сцены.\"}}},\"metadata\":{\"title\":\"MaxGPT - Чат GPT-5 Бесплатно на Русском\",\"titlePro\":\"MaxGPT - ИИ Чат на Русском\",\"description\":\"Используй бесплатный Chat GPT-5 онлайн и без VPN. MaxGPT — умный помощник на русском языке, который пишет тексты, код, находит ответы и многое другое\",\"keywords\":\"chat, gpt, chatgpt, chatgptx, чат, гпт, чатгпт, бесплатно, онлайн, русский, чатбот, openai, ии, ai, нейросеть\",\"sharedChat\":{\"title\":\"Посмотрите этот чат\",\"description\":\"С вами поделились чатом в MaxGPT — откройте ссылку, чтобы прочитать его целиком.\",\"tagline\":\"Чат с ИИ в MaxGPT\",\"imageAlt\":\"Фрагмент чата в MaxGPT\"},\"chat\":{\"claude\":{\"title\":\"Чат Claude Sonnet 4.6 онлайн — MaxGPT\",\"description\":\"Общайся с Claude Sonnet 4.6 от Anthropic онлайн и без VPN. Умный ИИ-ассистент для кода, анализа текста и творческих задач на русском языке.\",\"keywords\":\"claude, claude sonnet, anthropic, чат claude, claude онлайн, claude на русском, ии ассистент\"},\"claude-sonnet-4\":{\"title\":\"Чат Claude Sonnet 4.6 — MaxGPT\",\"description\":\"Claude Sonnet 4.6 от Anthropic — мощная модель для диалога, кода и анализа. Попробуй бесплатно на MaxGPT.\",\"keywords\":\"claude sonnet 4.6, claude, anthropic, чат claude, claude sonnet онлайн\"},\"claude-haiku-4\":{\"title\":\"Чат Claude Haiku 4.5 — MaxGPT\",\"description\":\"Claude Haiku 4.5 от Anthropic — быстрая и эффективная модель для повседневного чата. Попробуй на MaxGPT.\",\"keywords\":\"claude haiku, claude, anthropic, быстрый чат claude\"},\"deepseek\":{\"title\":\"Чат DeepSeek V4.1 онлайн — MaxGPT\",\"description\":\"DeepSeek V4.1 онлайн и без VPN. Мощный ИИ-ассистент для кода, математики и анализа на русском языке.\",\"keywords\":\"deepseek, deepseek v4.1, deepseek v4, чат deepseek, deepseek онлайн, deepseek на русском\"},\"deepseek